diff --git a/tools/decomp_sys/hpp_pilot.py b/tools/decomp_sys/hpp_pilot.py
index 358864def..99591f631 100644
--- a/tools/decomp_sys/hpp_pilot.py
+++ b/tools/decomp_sys/hpp_pilot.py
@@ -239,12 +239,82 @@ def gen_class_hpp(cls, views, sigs, registry_size, extra_notes=(),
