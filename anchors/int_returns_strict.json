  "rules": {
   "base": "v2 guarded kinds: all ret sites const|arith and >=1 arith; re-verified on the current snapshot (stale v2 entries are re-classified, not trusted)",
   "const": "xor eax,eax / mov eax,imm (ffl6 immediate guard)",
   "gate_v2": "for every ARITH ret site the CFG int-state of eax at the ret instruction must be INT on every reaching path (join = AND over predecessors); a linear last-def proof is used only to name the failing register",
   "safe_int_ops": [
    "cdq",
    "cwd",
    "div",
    "idiv",
    "imul",
    "mul",
    "sal",
    "sar",
    "shl",
    "shr"
   ],
   "value_destroying_idioms": {
    "sbb r,r": "0 / -1 by CF only (independent of r)",
    "xor r,r": "0",
    "sub r,r": "0",
    "and r,0": "0",
    "or r,-1": "0xFFFFFFFF"
   },
   "partial_write_rule": "byte/word writes (mov al.., setcc, lahf) only replace low bits: an already-integer register stays integer, an unknown one stays unknown and is excluded",
   "cfg_completeness": "a function with an unresolved intra-function control transfer (switch jump table, indirect jmp, or a jump to a label missing from the exported block) is excluded (cfg-incomplete): the forward join could miss a reaching path",
   "excluded_provenance": "call results (eax/ecx/edx), memory loads, lea, mov r,offset, cmov/xchg/xadd/cmpxchg/xlat, string ops, pop, parameters (no definition) and unreachable defs are never proven integer",
   "one_failing_site": "one failing arith ret site excludes the function"
  },
